# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` al repo.
# ---------------------------------------------------------------------------

# Base de datos
DB_HOST=db
DB_PORT=3306
DB_NAME=verificador
DB_USER=verificador
DB_PASS=cambia_esta_clave
DB_CHARSET=utf8mb4

# Credenciales de root de MySQL (solo para docker-compose al levantar el contenedor db)
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root

# Aplicacion
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# OCR
# Comando de python dentro del contenedor. En la imagen Docker es "python3".
PYTHON_BIN=python3
# Ruta absoluta al binario de tesseract (opcional; vacio = usar el del PATH)
TESSERACT_BIN=
TESSERACT_LANG=spa
# Motor OCR: "rapidocr" (mas rapido y preciso, requiere rapidocr-onnxruntime) o
# "tesseract". Si se pide rapidocr y no esta instalado, cae a tesseract.
OCR_ENGINE=rapidocr
# Leer el numero directo del codigo PDF417 del reverso (exacto y muy rapido,
# sin OCR). 1=activado (por defecto), 0=desactivado. Requiere zxing-cpp.
OCR_BARCODE=1
# Hilos de onnxruntime por proceso OCR. Al procesar varias imagenes en paralelo
# conviene que OCR_THREADS x concurrencia(uploader.js) = nucleos fisicos.
# Ej.: 8 nucleos -> OCR_THREADS=2 con concurrencia 4.
OCR_THREADS=2
# Reescalar la imagen a este lado maximo (px) antes del OCR (acelera). 0=no reescalar.
OCR_MAX_SIDE=1600
# Lado máximo del detector; el reconocimiento conserva la resolución de entrada.
RAPIDOCR_DET_SIDE=960
# Líneas por cálculo del reconocedor. 1 reduce el relleno de líneas en CPU.
OCR_REC_BATCH=1
# Lectura progresiva por zonas; 0 permite comparar contra reconocimiento completo.
OCR_ZONES=1
# Reutilizar resultados de imágenes idénticas durante 7 días.
OCR_CACHE=1
# Incrementar al reemplazar modelos o actualizar dependencias OCR instaladas.
OCR_CACHE_VERSION=1
